<Window x:Class="DesktopWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#F0202028">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="OpenRouter API Key" Foreground="#DDDDDD" FontSize="12"/>
            <TextBox x:Name="TxtKey" Margin="0,4,0,0" Padding="6,4"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="机场 API 地址（推荐，自动实时流量）" Foreground="#DDDDDD" FontSize="12"/>
            <TextBox x:Name="TxtApiUrl" Margin="0,4,0,0" Padding="6,4"/>
            <TextBlock Text="填机场官网域名，如 https://app.maomao234.com 。插件用账号密码自动登录后台 API 拉取实时流量。" Foreground="#8899AA" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="机场账号 / 密码（用于自动登录，会话过期时自动重登）" Foreground="#DDDDDD" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="TxtAirportUser" Width="240" Padding="6,4" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtAirportPass" Width="200" Padding="6,4"/>
            </StackPanel>
            <TextBlock Text="仅保存在本机配置文件中，不会上传。" Foreground="#8899AA" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="刷新间隔（小时）：" Foreground="#DDDDDD" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtInterval" Width="60" Padding="6,4"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Padding="0,6" Click="Save_Click" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Padding="0,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
