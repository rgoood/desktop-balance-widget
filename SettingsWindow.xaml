<Window x:Class="DesktopWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="300"
        WindowStartupLocation="CenterOwner"
        Background="#F0202028">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="OpenRouter API Key" Foreground="#DDDDDD" FontSize="12"/>
            <TextBox x:Name="TxtKey" Margin="0,4,0,0" Padding="6,4"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="机场订阅链接（Clash/V2Ray 订阅 URL）" Foreground="#DDDDDD" FontSize="12"/>
            <TextBox x:Name="TxtSubUrl" Margin="0,4,0,0" Padding="6,4"/>
            <TextBlock Text="提示：若机场订阅开关默认关闭，查询流量前请先到官网临时打开开关。" Foreground="#8899AA" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="刷新间隔（小时）：" Foreground="#DDDDDD" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtInterval" Width="60" Padding="6,4"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Padding="0,6" Click="Save_Click" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Padding="0,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
