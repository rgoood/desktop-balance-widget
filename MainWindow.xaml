<Window x:Class="DesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面余额小组件"
        Width="340" SizeToContent="Height"
        MaxWidth="340"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="40" Top="40">
    <Grid>
        <Border Background="#E8202028" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                    <TextBlock Text="监控面板" FontSize="13" FontWeight="Bold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WidgetButton}"
                                Width="26" Height="22" Click="Refresh_Click" ToolTip="立即刷新" Margin="0,0,4,0"/>
                        <Button x:Name="BtnEmbed" Content="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WidgetButton}"
                                Width="26" Height="22" Click="Embed_Click" ToolTip="嵌入桌面（不遮挡窗口）" Margin="0,0,4,0"/>
                        <Button x:Name="BtnPin" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WidgetButton}"
                                Width="26" Height="22" Click="Pin_Click" ToolTip="取消置顶/置顶" Margin="0,0,4,0"/>
                        <Button x:Name="BtnSettings" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WidgetButton}"
                                Width="26" Height="22" Click="Settings_Click" ToolTip="设置（API Key / 订阅链接）" Margin="0,0,4,0"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource WidgetButton}"
                                Width="26" Height="22" Click="Minimize_Click" ToolTip="最小化到托盘"/>
                    </StackPanel>
                </DockPanel>

                <!-- OpenRouter -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="OpenRouter 余额" FontSize="10" Foreground="#8899AA"/>
                    <TextBlock x:Name="TxtBalance" Text="--" FontSize="18" FontWeight="Bold" Foreground="#7CDB70"/>
                </StackPanel>

                <Separator Grid.Row="2" Margin="0,8" Background="#22FFFFFF"/>

                <!-- 机场流量 -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="机场流量" FontSize="10" Foreground="#8899AA"/>
                    <TextBlock x:Name="TxtTraffic" Text="--" FontSize="12" FontWeight="Bold" Foreground="#6CC3FF" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="BarTraffic" Height="4" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                 Foreground="#6CC3FF" Background="#22FFFFFF" BorderThickness="0"/>
                    <TextBlock x:Name="TxtExpire" Text="" FontSize="10" Foreground="#8899AA" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 状态栏 -->
                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtStatus" Text="初始化..." FontSize="11" Foreground="#99AABB" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtNext" Text="" FontSize="11" Foreground="#99AABB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
